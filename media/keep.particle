particle_system Keep/Flame
{
    material            Keep/Spark
    particle_width      13
    particle_height     13
    quota               400
    billboard_type      point

    emitter Point
    {
        angle           16
        emission_rate   90
        time_to_live    0.9
        direction       0 1 0
        velocity_min    26
        velocity_max    52
        colour          0.20 0.15 0.055 1
    }

    affector ColourFader
    {
        red             -0.055
        green           -0.21
        blue            -0.075
        alpha           -1.05
    }

    affector Scaler
    {
        rate            -9
    }
}

// The same flame with a low ceiling. It has to be a SEPARATE system because a quota can be
// raised after creation and never lowered, so there is no way to get here from Keep/Flame.
particle_system Keep/FlameCapped
{
    material            Keep/Spark
    particle_width      13
    particle_height     13
    quota               30
    billboard_type      point

    emitter Point
    {
        angle           16
        emission_rate   90
        time_to_live    0.9
        direction       0 1 0
        velocity_min    26
        velocity_max    52
        colour          0.20 0.15 0.055 1
    }

    affector ColourFader
    {
        red             -0.055
        green           -0.21
        blue            -0.075
        alpha           -1.05
    }

    affector Scaler
    {
        rate            -9
    }
}

particle_system Keep/Smoke
{
    material            Keep/Smoke
    particle_width      34
    particle_height     34
    quota               220
    billboard_type      point

    emitter Box
    {
        width           22
        height          6
        depth           22
        angle           34
        emission_rate   18
        time_to_live    3.4
        direction       0 1 0
        velocity_min    14
        velocity_max    26
        colour          0.16 0.15 0.17 0.42
    }

    affector ColourFader
    {
        alpha           -0.17
    }

    affector Scaler
    {
        rate            16
    }

    affector LinearForce
    {
        force_vector    -9 2 0
        force_application add
    }
}
